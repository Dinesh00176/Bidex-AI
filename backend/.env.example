# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas for Production or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/bidwise-ai

# Google Gemini API Key (Backend-only, NEVER exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g. gemini-3.5-flash, gemini-3.6-flash, gemini-3.7-flash)
GEMINI_MODEL=gemini-3.5-flash

# JWT Secret for authentication tokens
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
